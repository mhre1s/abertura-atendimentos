# Exemplo de configuração - Copie para .env e preencha com seus dados

# API RBX
RBX_BASE_URL=https://seu-rbx.com.br/api
RBX_API_KEY=
RBX_CLIENT_ID=
RBX_CLIENT_SECRET=

# BANCO DE DADOS
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=
